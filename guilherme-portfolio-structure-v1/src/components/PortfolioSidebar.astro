---
const navItems = [
  { href: '/', label: 'Home', icon: '⌂' },
  { href: '/#about', label: 'About', icon: '○' },
  { href: '/resume/', label: 'Resume', icon: '▣' },
  { href: '/projects/', label: 'Projects', icon: '▱' },
  { href: '/stories/', label: 'Stories', icon: '✎' },
  { href: '/gallery/', label: 'Gallery', icon: '▤' },
  { href: '/videos/', label: 'Videos', icon: '▶' },
  { href: '/biblioteca/', label: 'Library', icon: '□' },
  { href: '/certifications/', label: 'Certifications', icon: '✓' },
  { href: '/contact/', label: 'Contact', icon: '✉' },
];
---
<button class="mobile-nav-toggle" type="button" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">
  <span></span>
  <span></span>
  <span></span>
</button>

<div class="mobile-overlay" data-close-menu></div>

<aside id="sidebar" class="portfolio-sidebar" aria-label="Navegação lateral">
  <div class="sidebar-inner">
    <a class="profile-link" href="/" aria-label="Voltar para o início">
      <img class="sidebar-avatar" src="/images/profile-placeholder.svg" alt="Foto de Guilherme Rodrigues" />
      <strong>Guilherme Rodrigues</strong>
      <span>Computer Engineering</span>
    </a>

    <div class="social-links" aria-label="Links sociais">
      <a href="https://www.linkedin.com/in/guilherme-rodrigues-b39a751a7/" target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <a href="https://github.com/GuilhermeRds1921" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a href="mailto:guilhermerodrigues1921@gmail.com" aria-label="Email">@</a>
    </div>

    <nav class="side-nav">
      {navItems.map((item) => (
        <a href={item.href} data-close-menu>
          <span class="nav-icon" aria-hidden="true">{item.icon}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="sidebar-footer">
      <a href="/biblioteca/">Technical Library</a>
    </div>
  </div>
</aside>
