---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExternalImage from '../../components/ExternalImage.astro';
import galleryMedia from '../../data/media/gallery.json';

const albums = galleryMedia.albums;
---
<PortfolioLayout title="Galeria | Guilherme Rodrigues">
  <PageHeader eyebrow="Arquivo de mídia" title="Galeria" description="Um espaço dedicado para imagens de projetos, protótipos, eventos, laboratórios, PCBs, robôs, competições e bastidores." />

  <section class="content-section">
    <div class="gallery-grid">
      {albums.map((album) => (
        <figure>
          <ExternalImage image={album.image} />
          <figcaption><strong>{album.title}</strong><span>{album.caption}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
</PortfolioLayout>
