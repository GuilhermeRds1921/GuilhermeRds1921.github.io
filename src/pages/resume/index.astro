---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const items = [
  { period: '2025 — presente', title: 'Biometria Neonatal UTFPR', subtitle: 'Bolsa de pesquisa de graduação', text: 'Visão computacional, aprendizado de máquina, processamento de imagens e inferência de IA embarcada.' },
  { period: '2023 — 2024', title: 'Secretaria Municipal de Ciência, Tecnologia e Inovação de Pato Branco', subtitle: 'Estágio em desenvolvimento', text: 'Experiência profissional envolvendo tecnologia, desenvolvimento e suporte a soluções digitais.' },
  { period: '2022 — 2023', title: 'Pato a Jato', subtitle: 'Telemetria e eletrônica', text: 'Telemetria para o protótipo a combustão e desenvolvimento/validação de PCB para o primeiro protótipo elétrico.' },
  { period: '2022 — 2023', title: 'Robotnik', subtitle: 'Bolsa de extensão em robótica', text: 'Protótipos de robótica, demonstrações e atividades de divulgação científica.' },
  { period: '2019 — 2026', title: 'Engenharia de Computação', subtitle: 'UTFPR · Pato Branco', text: 'Graduação em Engenharia de Computação.' },
];
---
<PortfolioLayout title="Currículo | Guilherme Rodrigues">
  <PageHeader eyebrow="Carreira" title="Currículo" description="Uma visão estruturada da experiência acadêmica, estágios, pesquisa, equipes estudantis e trajetória técnica." />

  <section class="content-section">
    <div class="timeline">
      {items.map((item) => (
        <article class="timeline-item">
          <span class="period">{item.period}</span>
          <h3>{item.title}</h3>
          <h4>{item.subtitle}</h4>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</PortfolioLayout>
