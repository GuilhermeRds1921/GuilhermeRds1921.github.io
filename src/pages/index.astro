---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import HomePage from '../components/HomePage.astro';
import { homeContent } from '../data/pages/home';
import { projectListContent } from '../data/pages/projects';

const content = homeContent.pt;
---

<PortfolioLayout title={content.meta.title} description={content.meta.description}>
  <HomePage content={content} projects={projectListContent.pt.projects} />
</PortfolioLayout>
