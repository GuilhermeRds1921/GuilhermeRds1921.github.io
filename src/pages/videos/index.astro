---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import VideoGallery from '../../components/VideoGallery.astro';
import videosMedia from '../../data/media/videos.json';
---
<PortfolioLayout title="Vídeos | Guilherme Rodrigues">
  <PageHeader eyebrow="Demonstrações" title="Vídeos" description="Um espaço central para vídeos explicativos, demonstrações de projetos, registros de apresentações e explicações técnicas." />

  <section class="content-section">
    <VideoGallery videos={videosMedia.videos} />
  </section>
</PortfolioLayout>
