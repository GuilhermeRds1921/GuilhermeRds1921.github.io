---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---
<PortfolioLayout title="Stories | Guilherme Rodrigues">
  <PageHeader eyebrow="Long-form" title="Stories" description="A space for longer texts: project histories, lessons learned, university experiences and personal technical growth." />

  <section class="content-section">
    <div class="story-grid">
      <a class="story-card" href="/stories/minha-trajetoria/">
        <span>Trajectory</span>
        <h2>Minha trajetória na UTFPR</h2>
        <p>Um texto maior para contar como fui me encontrando na Engenharia de Computação através de projetos, pesquisa, extensão e protótipos.</p>
      </a>
      <a class="story-card" href="/projects/pato-a-jato/">
        <span>Competition</span>
        <h2>Pato a Jato e a competição no Rio</h2>
        <p>História da participação na equipe, telemetria, PCBs e aprendizados da competição de eficiência energética.</p>
      </a>
      <a class="story-card" href="/projects/robotnik/">
        <span>Outreach</span>
        <h2>Robotnik e divulgação científica</h2>
        <p>Como a robótica e os projetos de demonstração ajudaram a aproximar tecnologia da comunidade externa.</p>
      </a>
    </div>
  </section>
</PortfolioLayout>
