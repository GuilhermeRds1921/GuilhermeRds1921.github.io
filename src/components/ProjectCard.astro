---
const { title, href, text, tags = [], media = 'placeholder', image = '' } = Astro.props;
---
<a class="project-card rich-project-card" href={href}>
  <div class="project-thumb" data-media={media}>
    {image && <img src={image} alt="" loading="lazy" />}
  </div>
  <div>
    <h3>{title}</h3>
    <p>{text}</p>
    <div class="tag-row">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</a>
