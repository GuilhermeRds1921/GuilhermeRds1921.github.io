---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import ExternalImage from '../../../components/ExternalImage.astro';
import { robotnikMedia } from '../../../data/media/robotnik';
import { robotnikPageContent as content } from '../../../data/pages/robotnik';

const imagesById = new Map(robotnikMedia.gallery.map((image) => [image.id, image]));
---

<PortfolioLayout title={content.meta.title} description={content.meta.description}>
  <section
    class="project-detail-hero project-hero-robotics project-hero-image"
    style={`--project-hero-image: url('${content.hero.image.thumbnailUrl}')`}
  >
    <div>
      <p class="eyebrow">{content.hero.category}</p>
      <h1>{content.hero.title}</h1>
      <p>{content.hero.description}</p>
      <div class="tag-row">
        {content.hero.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>
  </section>

  <article class="content-section robotnik-page">
    <section class="project-intro-grid">
      <div class="project-body longform">
        <p class="lead">{content.summary}</p>

        <h2>{content.whatIs.title}</h2>
        {content.whatIs.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

        <h2>{content.participation.title}</h2>
        {content.participation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <aside class="project-aside robotnik-aside">
        <strong>Projeto</strong><span>Robotnik</span>
        <strong>Instituição</strong><span>UTFPR - Campus Pato Branco</span>
        <strong>Tipo</strong><span>Bolsa de extensão</span>
        <strong>Área</strong><span>Robótica e divulgação científica</span>
        <strong>Participação</strong><span>Prototipagem, eletrônica, montagem, testes e apresentações</span>
      </aside>
    </section>

    <section class="project-section">
      <div class="section-heading compact-heading">
        <h2>Linha do tempo</h2>
      </div>

      <div class="project-timeline">
        {content.timeline.map((item) => (
          <article>
            <span>{item.period}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="project-section sicite-section">
      <div class="section-heading compact-heading">
        <h2>{content.sicite.title}</h2>
        <p>{content.sicite.description}</p>
      </div>
    </section>

    <section class="project-section">
      <div class="section-heading compact-heading">
        <h2>Projetos e protótipos</h2>
        <p>
          Demonstrações e frentes relacionadas ao grupo, misturando robótica educacional,
          eletrônica aplicada, controle e atividades para o público.
        </p>
      </div>

      <div class="prototype-grid">
        {content.prototypes.map((prototype) => {
          const image = prototype.imageId ? imagesById.get(prototype.imageId) : undefined;

          return (
            <article class="prototype-card">
              {image && (
                <div class="prototype-media">
                  <ExternalImage
                    image={{
                      src: image.thumbnailUrl,
                      alt: image.alt,
                      fallback: '/images/projects/placeholder.svg',
                    }}
                  />
                </div>
              )}
              <div>
                <h3>{prototype.title}</h3>
                <p>{prototype.description}</p>
                <small>{prototype.concepts}</small>
                <div class="tag-row">
                  {prototype.tags.map((tag) => <span>{tag}</span>)}
                </div>
                {prototype.repository && (
                  <a
                    class="inline-link prototype-repo-link"
                    href={prototype.repository.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    referrerpolicy="no-referrer"
                  >
                    {prototype.repository.label}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="project-section media-hub-callout">
      <div class="section-heading compact-heading">
        <h2>Fotos e vídeos</h2>
        <p>
          Para manter as páginas dos projetos mais leves, as fotos e vídeos ficam concentrados nas áreas gerais de mídia do portfólio.
        </p>
      </div>

      <div class="contact-card compact-actions">
        <a class="btn btn-primary" href="/gallery/robotnik/">Ver fotos do Robotnik</a>
        <a class="btn" href="/videos/robotnik/">Ver vídeos do Robotnik</a>
      </div>
    </section>

    <section class="project-section project-two-columns">
      <div>
        <div class="section-heading compact-heading">
          <h2>Tecnologias e conceitos</h2>
        </div>

        <div class="skills-cloud compact-skills">
          {content.technologies.map((technology) => <span>{technology}</span>)}
        </div>
      </div>

      <div class="project-body longform">
        <h2>Aprendizados</h2>
        <ul>
          {content.learnings.map((learning) => <li>{learning}</li>)}
        </ul>
      </div>
    </section>

    <section class="project-section external-links-section">
      <div class="section-heading compact-heading">
        <h2>Links externos</h2>
      </div>

      <div class="contact-card compact-actions">
        {content.externalLinks.map((link) => (
          <a class="btn btn-primary" href={link.href} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">{link.label}</a>
        ))}
      </div>
    </section>
  </article>
</PortfolioLayout>
