---
type ImageItem = {
  src: string;
  alt: string;
  caption?: string;
};

const { images = [] } = Astro.props as { images: ImageItem[] };
---

<div class="image-grid">
  {images.map((image) => (
    <figure class="image-card">
      <img src={image.src} alt={image.alt} loading="lazy" />
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>
  ))}
</div>
