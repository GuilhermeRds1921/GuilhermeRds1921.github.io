---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExternalImage from '../../components/ExternalImage.astro';
import { projectAlbums } from '../../data/media/albums';
---

<PortfolioLayout title="Galeria | Guilherme Rodrigues">
  <PageHeader
    eyebrow="Arquivo de mídia"
    title="Galeria"
    description="As fotos ficam concentradas aqui, organizadas por projeto. Clique em um card para abrir o álbum completo daquele projeto."
  />

  <section class="content-section">
    <div class="album-grid">
      {projectAlbums.map((album) => (
        <a class="album-card" href={`/gallery/${album.slug}/`}>
          <div class="album-cover">
            <ExternalImage image={album.cover} />
            <span>
              {album.images.length > 0
                ? `${album.images.length} ${album.images.length === 1 ? 'foto' : 'fotos'}`
                : 'em preparação'}
            </span>
          </div>

          <div class="album-card-content">
            <strong>{album.title}</strong>
            <p>{album.caption}</p>
            <div class="tag-row">
              {album.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</PortfolioLayout>
