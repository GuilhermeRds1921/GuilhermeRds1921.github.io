---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const items = [
  { period: '2025 — present', title: 'Biometria Neonatal UTFPR', subtitle: 'Undergraduate Research Scholarship', text: 'Computer vision, machine learning, image processing and embedded AI inference.' },
  { period: '2023 — 2024', title: 'Secretaria Municipal de Ciência, Tecnologia e Inovação de Pato Branco', subtitle: 'Development Intern', text: 'Professional internship experience involving technology, development and support for digital solutions.' },
  { period: '2022 — 2023', title: 'Pato a Jato', subtitle: 'Telemetry and Electronics', text: 'Telemetry for the combustion prototype and PCB development/validation for the first electric prototype.' },
  { period: '2022 — 2023', title: 'Robotnik', subtitle: 'Robotics Outreach Scholarship', text: 'Robotics prototypes, demonstrations and scientific outreach activities.' },
  { period: '2019 — 2026', title: 'Computer Engineering', subtitle: 'UTFPR · Pato Branco', text: 'Undergraduate degree in Computer Engineering.' },
];
---
<PortfolioLayout title="Resume | Guilherme Rodrigues">
  <PageHeader eyebrow="Career" title="Resume" description="A structured overview of academic experience, internships, research, student teams and technical trajectory." />

  <section class="content-section">
    <div class="timeline">
      {items.map((item) => (
        <article class="timeline-item">
          <span class="period">{item.period}</span>
          <h3>{item.title}</h3>
          <h4>{item.subtitle}</h4>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</PortfolioLayout>
