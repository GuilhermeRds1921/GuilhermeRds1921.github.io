---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const albums = [
  { title: 'Biometria Neonatal', caption: 'Configuração, testes, execução e resultados do TCC.' },
  { title: 'Pato a Jato', caption: 'Oficina, PCBs, protótipos e competição.' },
  { title: 'Robotnik', caption: 'Robôs, cubo de LED, oficinas e divulgação científica.' },
  { title: 'Eventos UTFPR', caption: 'Feiras, cursos, oficinas e ações com a comunidade.' },
  { title: 'Eletrônica e PCB', caption: 'Placas, CNC, validações e montagens.' },
  { title: 'Laboratório', caption: 'Bancadas, protótipos, testes e bastidores.' },
];
---
<PortfolioLayout title="Galeria | Guilherme Rodrigues">
  <PageHeader eyebrow="Arquivo de mídia" title="Galeria" description="Um espaço dedicado para imagens de projetos, protótipos, eventos, laboratórios, PCBs, robôs, competições e bastidores." />

  <section class="content-section">
    <div class="gallery-grid">
      {albums.map((album) => (
        <figure>
          <img src="/images/projects/placeholder.svg" alt={album.title} />
          <figcaption><strong>{album.title}</strong><span>{album.caption}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
</PortfolioLayout>
