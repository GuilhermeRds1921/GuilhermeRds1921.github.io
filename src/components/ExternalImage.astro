---
import type { MediaImage, ResolvedMediaImage } from '../lib/media';
import { resolveMediaImage, sanitizeImageUrl } from '../lib/media';

const {
  image,
  class: className,
  loading = 'lazy',
  decoding = 'async',
} = Astro.props as {
  image: MediaImage | ResolvedMediaImage;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
};

const resolved = 'src' in image && image.src ? image as ResolvedMediaImage : resolveMediaImage(image as MediaImage);
const fallbackSrc = sanitizeImageUrl(resolved.fallback);
const imageSrc = sanitizeImageUrl(resolved.src, fallbackSrc);
const classes = ['reveal-image', className].filter(Boolean).join(' ');
---

<img
  src={imageSrc}
  alt={resolved.alt}
  class={classes}
  loading={loading}
  decoding={decoding}
  referrerpolicy="no-referrer"
  data-reveal-image
  data-fallback-src={fallbackSrc}
  data-loaded="false"
/>

<script>
  const bindRevealImage = (image: Element) => {
    if (!(image instanceof HTMLImageElement) || image.dataset.revealImageBound) return;

    image.dataset.revealImageBound = 'true';

    const applyFallback = () => {
      const fallbackSrc = image.dataset.fallbackSrc;

      if (fallbackSrc && image.src !== new URL(fallbackSrc, window.location.origin).href) {
        image.dataset.loaded = 'false';
        image.src = fallbackSrc;
        return;
      }

      image.dataset.loaded = 'true';
    };

    image.addEventListener('load', () => {
      image.dataset.loaded = 'true';
    });

    image.addEventListener('error', applyFallback);

    if (image.complete) {
      if (image.naturalWidth > 0) {
        image.dataset.loaded = 'true';
      } else {
        applyFallback();
      }
    }
  };

  document.querySelectorAll('[data-reveal-image]').forEach(bindRevealImage);
</script>
