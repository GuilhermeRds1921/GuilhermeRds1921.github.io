---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const facts = [
  { value: '4+', label: 'frentes principais', detail: 'Embarcados, IoT, IA aplicada e Cybersecurity' },
  { value: '7+', label: 'anos na UTFPR-PB', detail: 'com pandemia no meio e retomada forte em projetos' },
  { value: '2º', label: 'lugar em competição', detail: 'Pato a Jato · categoria combustão' },
  { value: '1', label: 'TCC em IA embarcada', detail: 'Machine learning em Raspberry Pi e ARM Linux' },
];

const projects = [
  {
    title: 'Biometria Neonatal / TCC',
    href: '/projects/biometria-neonatal/',
    text: 'Integração de machine learning em plataformas embarcadas, avaliando inferência de redes neurais em Raspberry Pi e ARM Linux.',
    tags: ['IA Embarcada', 'ONNX', 'OpenCV', 'Linux'],
    media: 'ai',
  },
  {
    title: 'Pato a Jato',
    href: '/projects/pato-a-jato/',
    text: 'Telemetria, desenvolvimento com ESP32, fabricação e validação de PCBs em equipe de competição de eficiência energética.',
    tags: ['Telemetria', 'ESP32', 'PCB'],
    media: 'car',
  },
  {
    title: 'Robotnik',
    href: '/projects/robotnik/',
    text: 'Robótica, divulgação científica e protótipos como hexapod, cubo de LED, robô Otto e mesa robótica de equilíbrio de bola.',
    tags: ['Robótica', 'Extensão', 'Protótipos'],
    media: 'robotics',
  },
  {
    title: 'Ball Balancing Robot',
    href: '/projects/ball-balancing-robot/',
    text: 'Mesa robótica com Raspberry Pi, câmera, servos, controle PD, FastAPI, React e telemetria em tempo real.',
    tags: ['Controle', 'Raspberry Pi', 'Visão Computacional'],
    media: 'control',
  },
];

const skills = [
  'C', 'C++', 'Python', 'Linux', 'Git/GitHub', 'Raspberry Pi', 'ESP32', 'IoT', 'Telemetria',
  'Sistemas Embarcados', 'Eletrônica Aplicada', 'Sensores', 'Dashboards', 'OpenCV', 'Machine Learning',
  'Cybersecurity', 'React', 'Tailwind', 'FastAPI', 'SQL', 'Fusion 360', 'PCB', 'Modelagem 3D'
];
---
<PortfolioLayout title="Guilherme Rodrigues | Portfolio">
  <section id="home" class="hero-section">
    <div class="hero-content">
      <h1>Guilherme Rodrigues</h1>
      <p class="hero-role">I'm a <span>Computer Engineering student</span></p>
      <p class="hero-summary">
        Portfolio, project archive and technical library. A place to organize prototypes, stories, videos, photos,
        research notes and everything I have been building with software, hardware, IoT, AI and Cybersecurity.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/projects/">View projects</a>
        <a class="btn btn-glass" href="/biblioteca/">Open library</a>
      </div>
    </div>
  </section>

  <section id="about" class="content-section">
    <div class="section-heading">
      <h2>About</h2>
    </div>

    <div class="about-grid">
      <div class="profile-card">
        <img src="/images/profile-placeholder.svg" alt="Foto ou avatar de Guilherme Rodrigues" />
      </div>

      <div class="about-copy">
        <h3>Computer Engineering student focused on applied technology.</h3>
        <p>
          Sou estudante de Engenharia de Computação na UTFPR-PB. Minha trajetória foi construída principalmente na prática,
          participando de projetos de robótica, extensão, competição, pesquisa e desenvolvimento de protótipos.
        </p>
        <p>
          Tenho bastante interesse pela área onde software e hardware se encontram: sistemas embarcados, sensores,
          telemetria, IoT, dashboards, Linux, C/C++, Python, IA aplicada e Segurança da Informação.
        </p>
        <p>
          Atualmente participo do Grupo de Biometria Neonatal e desenvolvo meu TCC sobre integração de machine learning em
          plataformas embarcadas, avaliando inferência de modelos em dispositivos como Raspberry Pi.
        </p>
        <div class="info-list">
          <div><strong>City:</strong> Pato Branco, Paraná, Brazil</div>
          <div><strong>Education:</strong> Computer Engineering · UTFPR-PB</div>
          <div><strong>Focus:</strong> Embedded Systems, IoT, AI, Automation and Cybersecurity</div>
          <div><strong>Looking for:</strong> Internship opportunities in technology</div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section alt-section">
    <div class="section-heading">
      <h2>Facts</h2>
      <p>Some quick facts about my academic, technical and project-based path.</p>
    </div>
    <div class="facts-grid">
      {facts.map((fact) => (
        <article class="fact-card">
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
          <small>{fact.detail}</small>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="content-section">
    <div class="section-heading">
      <h2>Featured projects</h2>
      <p>
        Each project page is built to support long-form stories, technical explanations, image galleries,
        videos, diagrams, source links and lessons learned.
      </p>
    </div>
    <div class="project-grid project-grid-2x">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <section id="content-map" class="content-section alt-section">
    <div class="section-heading">
      <h2>Portfolio structure</h2>
      <p>This site is organized as a large archive, not only a resume.</p>
    </div>
    <div class="structure-grid">
      <a href="/projects/" class="structure-card"><strong>Projects</strong><span>Technical pages with goals, architecture, media and results.</span></a>
      <a href="/stories/" class="structure-card"><strong>Stories</strong><span>Long texts about my path, competitions, groups and lessons learned.</span></a>
      <a href="/gallery/" class="structure-card"><strong>Gallery</strong><span>Photo collections from prototypes, events, labs and experiments.</span></a>
      <a href="/videos/" class="structure-card"><strong>Videos</strong><span>Demonstrations, presentations and explanatory recordings.</span></a>
      <a href="/biblioteca/" class="structure-card"><strong>Library</strong><span>Searchable technical notes, studies, templates and documentation.</span></a>
      <a href="/certifications/" class="structure-card"><strong>Certifications</strong><span>Courses, Cisco materials, certificates and learning history.</span></a>
    </div>
  </section>

  <section id="skills" class="content-section">
    <div class="section-heading">
      <h2>Skills</h2>
      <p>Tools and areas that appear across my projects and studies.</p>
    </div>
    <div class="skills-cloud">
      {skills.map((skill) => <span>{skill}</span>)}
    </div>
  </section>

  <section id="contact" class="content-section contact-section alt-section">
    <div class="section-heading">
      <h2>Contact</h2>
      <p>Open to internship opportunities in technology, embedded systems, automation, AI and Cybersecurity.</p>
    </div>
    <div class="contact-card">
      <a class="btn btn-primary" href="mailto:guilhermerodrigues1921@gmail.com">Email</a>
      <a class="btn" href="https://github.com/GuilhermeRds1921" target="_blank" rel="noreferrer">GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/guilherme-rodrigues-b39a751a7/" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
  </section>
</PortfolioLayout>
