---
import { youtubeEmbedUrl } from '../lib/media';

const { title = 'Vídeo', youtubeId = '', youtubeUrl = '', caption = '' } = Astro.props;
const embedSrc = youtubeEmbedUrl({ youtubeId, youtubeUrl });
---
<figure class="video-embed">
  {embedSrc ? (
    <iframe src={embedSrc} title={title} loading="lazy" referrerpolicy="no-referrer" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
  ) : (
    <div class="video-placeholder">▶</div>
  )}
  <figcaption>
    <strong>{title}</strong>
    {caption && <span>{caption}</span>}
  </figcaption>
</figure>
