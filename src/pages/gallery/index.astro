---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const albums = [
  { title: 'Biometria Neonatal', caption: 'Setup, testes, execução e resultados do TCC.' },
  { title: 'Pato a Jato', caption: 'Oficina, PCBs, protótipos e competição.' },
  { title: 'Robotnik', caption: 'Robôs, cubo de LED, oficinas e divulgação científica.' },
  { title: 'Eventos UTFPR', caption: 'Feiras, cursos, oficinas e ações com a comunidade.' },
  { title: 'Eletrônica e PCB', caption: 'Placas, CNC, validações e montagens.' },
  { title: 'Laboratório', caption: 'Bancadas, protótipos, testes e bastidores.' },
];
---
<PortfolioLayout title="Gallery | Guilherme Rodrigues">
  <PageHeader eyebrow="Media archive" title="Gallery" description="A dedicated space for many images: projects, prototypes, events, labs, PCBs, robots, competitions and behind-the-scenes records." />

  <section class="content-section">
    <div class="gallery-grid">
      {albums.map((album) => (
        <figure>
          <img src="/images/projects/placeholder.svg" alt={album.title} />
          <figcaption><strong>{album.title}</strong><span>{album.caption}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
</PortfolioLayout>
