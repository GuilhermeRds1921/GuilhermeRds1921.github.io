---
import { getLangFromUrl, getLocalizedPath } from '../lib/i18n';

const currentLang = getLangFromUrl(Astro.url.pathname);
const isPT = currentLang === 'pt';

const ptPath = getLocalizedPath(Astro.url.pathname, 'pt');
const enPath = getLocalizedPath(Astro.url.pathname, 'en');

const navItems = [
  {
    href: isPT ? '/' : '/en/',
    label: isPT ? 'Início' : 'Home',
    icon: `<svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-8.5z"/></svg>`,
  },
  {
    href: isPT ? '/projects/' : '/en/projects/',
    label: isPT ? 'Projetos' : 'Projects',
    icon: `<svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H10l2 2h5.5A2.5 2.5 0 0 1 20 8.5v9A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-11z"/></svg>`,
  },
  {
    href: isPT ? '/gallery/' : '/en/gallery/',
    label: isPT ? 'Galeria' : 'Gallery',
    icon: `<svg viewBox="0 0 24 24"><path d="M5 5h14v14H5V5zm2 2v10h10V7H7zm1.2 8 2.6-3.2 1.8 2.2 1.3-1.6L16.5 15H8.2zM14.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/></svg>`,
  },
  {
    href: isPT ? '/laboratorio/' : '/en/laboratory/',
    label: isPT ? 'Laboratório' : 'Laboratory',
    icon: `<svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5.2 3.4 9.9 8 11 4.6-1.1 8-5.8 8-11V5l-8-3zm3.7 7.3 1.4 1.4-5.8 5.8-3.2-3.2 1.4-1.4 1.8 1.8 4.4-4.4z"/></svg>`,
    icon: `<svg viewBox="0 0 24 24"><path d="M9 3h6v2h-1v5.2l4.5 7.2A2.4 2.4 0 0 1 16.5 21h-9a2.4 2.4 0 0 1-2-3.6L10 10.2V5H9V3zm3 8.1-4.8 7.6a.4.4 0 0 0 .3.6h9a.4.4 0 0 0 .3-.6L12 11.1zM8.7 16h6.6l1.2 2H7.5l1.2-2z"/></svg>`,
  },
];
---

<button class="mobile-nav-toggle" type="button" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">
  <span></span>
  <span></span>
  <span></span>
</button>

<div class="mobile-overlay" data-close-menu></div>

<aside id="sidebar" class="portfolio-sidebar" aria-label="Navegação lateral">
  <div class="sidebar-inner">
    <a class="profile-link" href="/" aria-label="Voltar para o início">
      <img class="sidebar-avatar" src="/images/profile.jpg" alt="Foto de Guilherme Rodrigues" />
      <strong>Guilherme Rodrigues</strong>
      <span>Engenheiro de Computação</span>
    </a>

    <div class="sidebar-socials">
      <a
        href="https://www.linkedin.com/in/guilherme-rodrigues-dos-santos-b39a751a7/"
        target="_blank"
        rel="noopener noreferrer"
        referrerpolicy="no-referrer"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.05c.53-1 1.82-2.2 3.75-2.2 4 0 4.75 2.63 4.75 6.05V24h-4v-8.85c0-2.1-.04-4.8-2.93-4.8-2.93 0-3.37 2.29-3.37 4.65V24h-4V8z"/>
        </svg>
      </a>

      <a
        href="https://github.com/GuilhermeRds1921"
        target="_blank"
        rel="noopener noreferrer"
        referrerpolicy="no-referrer"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.1 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56v-2.15c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.04 1.76 2.72 1.25 3.38.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.42-2.69 5.38-5.25 5.67.42.36.79 1.08.79 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>

      <a
        href="https://www.instagram.com/gui_.rod/"
        target="_blank"
        rel="noopener noreferrer"
        referrerpolicy="no-referrer"
        aria-label="Instagram"
        title="Instagram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.25-2.35a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"/>
        </svg>
      </a>

      <a
        href="mailto:guilhermerodrigues1921@gmail.com"
        aria-label="Email"
        title="Email"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm0 2v.4l9 5.6 9-5.6V7H3zm18 10V9.75l-8.47 5.27a1 1 0 0 1-1.06 0L3 9.75V17h18z"/>
        </svg>
      </a>
    </div>

    <nav class="sidebar-nav" aria-label={isPT ? 'Navegação principal' : 'Main navigation'}>
      {navItems.map((item) => (
        <a class="nav-link" href={item.href}>
          <span class="nav-icon" set:html={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="sidebar-tools">
      <div class="language-picker">
        <a
          class:list={['language-icon-button', { active: isPT }]}
          href={ptPath}
          data-lang-link
          aria-label={isPT ? 'Português do Brasil' : 'Brazilian Portuguese'}
          title={isPT ? 'Português do Brasil' : 'Brazilian Portuguese'}
        >
          <span>🇧🇷</span>
        </a>

        <button
          type="button"
          class:list={['language-icon-button', { active: !isPT }]}
          data-language-menu-toggle
          aria-label={isPT ? 'Escolher outro idioma' : 'Choose another language'}
          aria-expanded="false"
          aria-controls="language-menu"
          title={isPT ? 'Escolher outro idioma' : 'Choose another language'}
        >
          <span>🌐</span>
        </button>

        <div id="language-menu" class="language-menu" data-language-menu hidden>
          <a href={enPath} data-lang-link>
            <strong>English</strong>
            <span>EN</span>
          </a>
        </div>
      </div>

      <button type="button" class="theme-toggle" data-theme-toggle>
        <span data-theme-icon>☾</span>
        <span data-theme-label>{isPT ? 'Modo escuro' : 'Dark mode'}</span>
      </button>
    </div>
  </div>
</aside>
