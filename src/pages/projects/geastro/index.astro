---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
---
<PortfolioLayout title="GeAstro | Guilherme Rodrigues">
  <section class="project-detail-hero project-hero-control">
    <div>
      <p class="eyebrow">Astronomia · Extensão · Divulgação científica</p>
      <h1>GeAstro</h1>
      <p>
        Projeto voltado à astronomia e à popularização da ciência, com atividades de observação,
        eventos e ações para aproximar a comunidade do conhecimento científico.
      </p>
      <div class="tag-row"><span>Astronomia</span><span>Extensão</span><span>Ciência</span><span>Comunidade</span></div>
    </div>
  </section>

  <article class="content-section project-layout-grid">
    <aside class="project-aside">
      <strong>Type</strong><span>Extensão / Divulgação científica</span>
      <strong>Area</strong><span>Astronomia e ciência aplicada</span>
      <strong>Status</strong><span>Projeto acadêmico</span>
    </aside>
    <div class="project-body longform">
      <h2>Overview</h2>
      <p>
        O GeAstro reúne atividades ligadas à astronomia, observações e divulgação científica,
        conectando universidade, tecnologia e comunidade em experiências práticas de aprendizagem.
      </p>

      <div class="image-grid">
        <figure class="image-card">
          <img src="/images/projects/geastro/cover.jpg" alt="Registro do projeto GeAstro" />
          <figcaption>GeAstro</figcaption>
        </figure>
      </div>
    </div>
  </article>
</PortfolioLayout>
