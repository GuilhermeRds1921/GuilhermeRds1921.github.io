---
import { youtubeEmbedUrl } from '../lib/media';

type VideoItem = {
  title: string;
  youtubeId?: string;
  youtubeUrl?: string;
  caption?: string;
};

const { videos = [] } = Astro.props as { videos: VideoItem[] };
---

<div class="media-grid">
  {videos.map((video) => (
    <div class="media-frame">
      {youtubeEmbedUrl(video) ? (
        <iframe
          title={video.title}
          src={youtubeEmbedUrl(video)}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      ) : video.youtubeUrl ? (
        <a class="video-placeholder video-link-placeholder" href={video.youtubeUrl} target="_blank" rel="noreferrer">
          Abrir no YouTube
        </a>
      ) : (
        <div class="video-placeholder">▶</div>
      )}
      {(video.caption || video.title) && <div class="media-caption">{video.caption ?? video.title}</div>}
    </div>
  ))}
</div>
