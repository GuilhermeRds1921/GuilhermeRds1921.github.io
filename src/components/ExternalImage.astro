---
import type { MediaImage, ResolvedMediaImage } from '../lib/media';
import { resolveMediaImage } from '../lib/media';

const {
  image,
  class: className,
  loading = 'lazy',
  decoding = 'async',
} = Astro.props as {
  image: MediaImage | ResolvedMediaImage;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
};

const resolved = 'src' in image && image.src ? image as ResolvedMediaImage : resolveMediaImage(image as MediaImage);
const classes = ['reveal-image', className].filter(Boolean).join(' ');
---

<img
  src={resolved.src}
  alt={resolved.alt}
  class={classes}
  loading={loading}
  decoding={decoding}
  data-fallback-src={resolved.fallback}
  data-loaded="false"
  onload="this.dataset.loaded = 'true';"
  onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.dataset.loaded = 'false'; this.src = this.dataset.fallbackSrc; } else { this.dataset.loaded = 'true'; }"
/>
