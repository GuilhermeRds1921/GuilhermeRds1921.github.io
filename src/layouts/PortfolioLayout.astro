---
import PortfolioSidebar from '../components/PortfolioSidebar.astro';
import '../styles/custom.css';
import { getLangFromUrl } from '../lib/i18n';

const currentLang = getLangFromUrl(Astro.url.pathname);

const {
  title = 'Guilherme Rodrigues | Portfolio',
  description = 'Portfolio de Guilherme Rodrigues: Engenharia de Computação, sistemas embarcados, IoT, IA aplicada, automação e Segurança da Informação.',
  lang = currentLang === 'pt' ? 'pt-BR' : 'en',
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#040b14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>

  <body class="portfolio-home">
    <PortfolioSidebar />

    <main class="home-main">
      <slot />
    </main>

    <script define:vars={{ currentLang }}>
      (() => {
        const root = document.documentElement;
        const body = document.body;

        /*
          TEMA CLARO / ESCURO
        */
        const savedTheme = localStorage.getItem('portfolio-theme') || 'dark';

        function setTheme(theme) {
          root.dataset.theme = theme;
          localStorage.setItem('portfolio-theme', theme);

          const icon = document.querySelector('[data-theme-icon]');
          const label = document.querySelector('[data-theme-label]');

          if (!icon || !label) return;

          if (theme === 'dark') {
            icon.textContent = '☀';
            label.textContent = currentLang === 'pt' ? 'Modo claro' : 'Light mode';
          } else {
            icon.textContent = '☾';
            label.textContent = currentLang === 'pt' ? 'Modo escuro' : 'Dark mode';
          }
        }

        document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
          const current = root.dataset.theme || 'dark';
          setTheme(current === 'dark' ? 'light' : 'dark');
        });

        setTheme(savedTheme);

        /*
          MENU MOBILE
        */
        const toggle = document.querySelector('.mobile-nav-toggle');
        const closeTargets = document.querySelectorAll('[data-close-menu], .profile-link, .nav-link');

        function setMenu(open) {
          body.classList.toggle('sidebar-open', open);
          toggle?.setAttribute('aria-expanded', String(open));
        }

        toggle?.addEventListener('click', () => {
          setMenu(!body.classList.contains('sidebar-open'));
        });

        closeTargets.forEach((target) => {
          target.addEventListener('click', () => setMenu(false));
        });

        /*
          TOAST
        */
        let toast = document.querySelector('[data-toast]');
        let toastTimer;

        function ensureToast() {
          if (toast) return toast;

          toast = document.createElement('div');
          toast.className = 'site-toast';
          toast.setAttribute('data-toast', '');
          toast.setAttribute('role', 'status');
          toast.setAttribute('aria-live', 'polite');

          document.body.appendChild(toast);

          return toast;
        }

        function showToast(message) {
          const toastElement = ensureToast();

          toastElement.textContent =
            message ||
            (currentLang === 'pt'
              ? 'Esta versão ainda não está disponível.'
              : 'This version is not available yet.');

          toastElement.classList.add('show');

          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => {
            toastElement.classList.remove('show');
          }, 3000);
        }

        async function pageExists(url) {
          const pathsToTry = [
            url.pathname,
            url.pathname.endsWith('/') ? url.pathname.slice(0, -1) : `${url.pathname}/`,
            `${url.pathname.replace(/\/$/, '')}/index.html`,
          ];

          for (const path of [...new Set(pathsToTry)]) {
            try {
              const response = await fetch(path + url.search, {
                method: 'GET',
                cache: 'no-store',
              });

              if (response.ok) {
                return path;
              }
            } catch {
              // tenta o próximo formato
            }
          }

          return null;
        }

        /*
          MENU DE IDIOMAS
        */
        const languageToggle = document.querySelector('[data-language-menu-toggle]');
        const languageMenu = document.querySelector('[data-language-menu]');

        function setLanguageMenu(open) {
          if (!languageToggle || !languageMenu) return;

          languageMenu.hidden = !open;
          languageToggle.setAttribute('aria-expanded', String(open));
        }

        languageToggle?.addEventListener('click', (event) => {
          event.stopPropagation();
          setLanguageMenu(languageMenu?.hidden ?? true);
        });

        document.addEventListener('click', (event) => {
          if (!languageMenu || languageMenu.hidden) return;

          const target = event.target;
          if (!(target instanceof Node)) return;

          if (!languageMenu.contains(target) && !languageToggle?.contains(target)) {
            setLanguageMenu(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setLanguageMenu(false);
          }
        });

        /*
          TROCA DE IDIOMA COM VERIFICAÇÃO DE PÁGINA
        */
        document.querySelectorAll('[data-lang-link]').forEach((link) => {
          link.addEventListener('click', async (event) => {
            setLanguageMenu(false);

            const href = link.getAttribute('href');
            if (!href) return;

            const targetUrl = new URL(href, window.location.origin);

            const currentPath = window.location.pathname.replace(/\/$/, '');
            const targetPath = targetUrl.pathname.replace(/\/$/, '');

            event.preventDefault();

            if (currentPath === targetPath) {
              showToast(
                currentLang === 'pt'
                  ? 'Você já está na versão em português.'
                  : 'You are already on the English version.'
              );
              return;
            }

           const existingPath = await pageExists(targetUrl);

            if (existingPath) {
              window.location.href = existingPath;
              return;
            }     

            const isTryingEnglish = targetUrl.pathname.startsWith('/en');

            showToast(
              isTryingEnglish
                ? 'Ainda não existe uma versão em inglês desta página.'
                : 'Ainda não existe uma versão em português desta página.'
            );
          });
        });
      })();
    </script>
  </body>
</html>
